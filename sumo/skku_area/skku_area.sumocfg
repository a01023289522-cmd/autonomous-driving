<configuration>
    <input>
        <net-file value="skku_area.net.xml"/>
        <route-files value="skku_area.bus.rou.xml,skku_area.cars.rou.xml,skku_area.parking.rou.xml"/>
        <additional-files value="skku_area.stops.add.xml,skku_area.parking.add.xml"/>
    </input>
    <processing>
        <step-length value="0.5"/>
        <time-to-teleport value="180"/>
    </processing>
    <gui_only>
        <gui-settings-file value="skku_area.gui.xml"/>
    </gui_only>
</configuration>
