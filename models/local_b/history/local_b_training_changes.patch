@@ -0,0 +1,89 @@
+"""PPO with an optional policy-drift constraint on saved route observations."""
+
+import copy
+import math
+
+import torch
+from torch.distributions import Categorical, Normal, kl_divergence
+
+from ppo_fix import PPOFixed
+
+
+class PPOAnchored(PPOFixed):
+    """Preserve the original acceleration and lane distributions off the target approach."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.anchor_kl_coef = 0.0
+        self._anchor_observations = None
+        self._anchor_reference = None
+        self._anchor_rng = torch.Generator(device="cpu")
+
+    def set_anchor_bank(self, observations, reference_checkpoint, *, coefficient, seed=0):
+        """Cache a frozen reference's predictions on the non-target route observations."""
+        coefficient = float(coefficient)
+        if not math.isfinite(coefficient) or coefficient < 0:
+            raise ValueError("Anchor KL coefficient must be finite and nonnegative.")
+        if coefficient == 0:
+            self.anchor_kl_coef = 0.0
+            self._anchor_observations = None
+            self._anchor_reference = None
+            return
+        if observations is None or reference_checkpoint is None:
+            raise ValueError("A positive anchor KL coefficient requires observations and a reference checkpoint.")
+        if self.policy_type != "hybrid":
+            raise ValueError("The anchor KL supports the hybrid acceleration and lane policy.")
+
+        dtype = next(self.policy.parameters()).dtype
+        bank = torch.as_tensor(observations, dtype=dtype, device=self.device).detach().clone()
+        if bank.ndim != 2 or len(bank) == 0 or not torch.isfinite(bank).all():
+            raise ValueError("The anchor bank must be a nonempty matrix of finite observations.")
+
+        reference = copy.deepcopy(self.policy).eval()
+        reference.load_state_dict(torch.load(reference_checkpoint, map_location=self.device, weights_only=True))
+        with torch.no_grad():
+            reference_mu, reference_std, reference_lanes, _ = reference(bank)
+        self._anchor_observations = bank
+        self._anchor_reference = (reference_mu, reference_std, reference_lanes)
+        self._anchor_rng.manual_seed(seed)
+        self.anchor_kl_coef = coefficient
+
+    def _sample_anchor_kl(self, batch_size):
+        indices = torch.randint(len(self._anchor_observations), (batch_size,), generator=self._anchor_rng)
+        indices = indices.to(self.device)
+        mu, std, lanes, _ = self.policy(self._anchor_observations[indices])
+        reference_mu, reference_std, reference_lanes = self._anchor_reference
+        acceleration_kl = kl_divergence(Normal(reference_mu[indices], reference_std), Normal(mu, std)).sum(-1)
+        lane_kl = kl_divergence(Categorical(logits=reference_lanes[indices]), Categorical(logits=lanes))
+        return (acceleration_kl + lane_kl).mean()
+
+    def update(self, advantages, returns):
+        if self.anchor_kl_coef == 0:
+            return super().update(advantages, returns)
+
+        buffer_size = len(self.buffer)
+        batches_per_epoch = math.ceil(buffer_size / self.minibatch_size)
+        gradient_limit = self.max_grad_norm
+        batch_count = 0
+        total_kl = 0.0
+
+        def add_anchor_gradient(_optimizer, _args, _kwargs):
+            nonlocal batch_count, total_kl
+            offset = (batch_count % batches_per_epoch) * self.minibatch_size
+            batch_size = min(self.minibatch_size, buffer_size - offset)
+            anchor_kl = self._sample_anchor_kl(batch_size)
+            (self.anchor_kl_coef * anchor_kl).backward()
+            torch.nn.utils.clip_grad_norm_(self.policy.parameters(), gradient_limit)
+            total_kl += anchor_kl.detach().item()
+            batch_count += 1
+
+        # Add the KL gradient after PPO backpropagates. Do the real clipping once on the sum.
+        hook = self.optimizer.register_step_pre_hook(add_anchor_gradient)
+        self.max_grad_norm = float("inf")
+        try:
+            stats = super().update(advantages, returns)
+        finally:
+            self.max_grad_norm = gradient_limit
+            hook.remove()
+        stats["anchor_kl"] = total_kl / max(batch_count, 1)
+        return stats
