@@ -0,0 +1,307 @@
+"""Place curriculum episodes on the Ilwol-ro approach using ordinary SUMO traffic."""
+
+import hashlib
+import json
+import math
+import os
+import random
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+import gymnasium as gym
+import numpy as np
+
+from skku_env import MAP, ROUTE_ID, TRAFFIC_FILES, SkkuEnv, route_edges, traci
+from stop_curriculum import STAGES, StopScene, sample_case
+
+
+ILWOL_EDGE = "5612296410"
+ILWOL_LANE = f"{ILWOL_EDGE}_2"
+ILWOL_SIGNAL = "520991292"
+ILWOL_LINK = 10
+
+
+@dataclass(frozen=True)
+class TrafficScene:
+    observation: np.ndarray
+    seed: int
+    distance_m: float
+    speed_mps: float
+    red_seconds: float
+
+
+class TrafficSceneUnavailable(RuntimeError):
+    """The requested scene could not be formed within the allotted SUMO time."""
+
+
+def _start_seed(env, seed):
+    prior_seeds, prior_next = env.seeds, env._next
+    env.use_seeds([seed])
+    try:
+        SkkuEnv._start_sumo(env)
+    finally:
+        env.seeds, env._next = prior_seeds, prior_next
+
+
+def _reset_tracking(env):
+    env.step_count = 0
+    env._prev_accel = None
+
+
+def _seconds_to_green(phases):
+    tls = traci.trafficlight
+    if tls.getRedYellowGreenState(ILWOL_SIGNAL)[ILWOL_LINK] not in "rR":
+        return 0.0
+    phase_index = tls.getPhase(ILWOL_SIGNAL)
+    remaining = tls.getNextSwitch(ILWOL_SIGNAL) - traci.simulation.getTime()
+    for offset in range(1, len(phases) + 1):
+        phase = phases[(phase_index + offset) % len(phases)]
+        if phase.state[ILWOL_LINK] in "gG":
+            return remaining
+        remaining += phase.duration
+    raise RuntimeError("일월로 학습 신호 프로그램에 통행 가능한 현시가 없습니다.")
+
+
+def _has_insertion_space(position, speed, ego_length, min_gap, clear_ahead):
+    vehicle = traci.vehicle
+    for vehicle_id in traci.lane.getLastStepVehicleIDs(ILWOL_LANE):
+        front = vehicle.getLanePosition(vehicle_id)
+        vehicle_speed = vehicle.getSpeed(vehicle_id)
+        if front >= position:
+            gap = front - vehicle.getLength(vehicle_id) - position
+            if clear_ahead or gap < min_gap + max(speed - vehicle_speed, 0.0) * 2.0:
+                return False
+        elif position - ego_length - front < min_gap + max(vehicle_speed - speed, 0.0) * 2.0:
+            return False
+    return True
+
+
+def reset_traffic_scene(env, *, distance_m, speed_mps, seed, min_red_seconds=15.0,
+                        max_red_seconds=None, max_wait_seconds=180.0, clear_ahead=True):
+    """Start one real-traffic scene from the given seed, with no signal overrides.
+
+    A scene is returned only when the ego has entered lane 2, the goal connection
+    shows red, and the requested initial distance and speed were realized. The
+    caller owns the seed sequence and decides how to use unavailable scenes.
+    """
+    if not all(math.isfinite(value) for value in (distance_m, speed_mps, min_red_seconds, max_wait_seconds)):
+        raise ValueError("학습 장면의 거리, 속도, 대기 시간은 유한한 값이어야 합니다.")
+    if distance_m <= 0 or speed_mps < 0 or min_red_seconds <= 0 or max_wait_seconds <= 0:
+        raise ValueError("학습 장면의 거리와 대기 시간은 양수, 속도는 0 이상이어야 합니다.")
+    if max_red_seconds is not None and (
+        not math.isfinite(max_red_seconds) or max_red_seconds - min_red_seconds < env.step_length
+    ):
+        raise ValueError("신호 시간 범위는 한 스텝 이상이어야 합니다.")
+    if env.gui:
+        raise ValueError("교통 커리큘럼 초기화는 학습용 GUI 없는 환경에만 적용됩니다.")
+    upper_red_seconds = math.inf if max_red_seconds is None else max_red_seconds
+
+    env.close()
+    gym.Env.reset(env, seed=seed)
+    _start_seed(env, seed)
+
+    try:
+        env.edges = route_edges(ILWOL_EDGE, env._full_edges[-1])
+        traci.route.add(ROUTE_ID, env.edges)
+        traci.vehicletype.copy("DEFAULT_VEHTYPE", "ego_type")
+        ego_length = traci.vehicletype.getLength("ego_type")
+        min_gap = traci.vehicletype.getMinGap("ego_type")
+        position = traci.lane.getLength(ILWOL_LANE) - distance_m
+        if position < ego_length or speed_mps > traci.lane.getMaxSpeed(ILWOL_LANE):
+            raise ValueError("지정한 일월로 투입 위치나 속도가 차로 범위를 벗어났습니다.")
+
+        tls = traci.trafficlight
+        program = tls.getProgram(ILWOL_SIGNAL)
+        logic = next((logic for logic in tls.getAllProgramLogics(ILWOL_SIGNAL) if logic.programID == program), None)
+        if logic is None or logic.type != 0 or any(phase.next for phase in logic.phases):
+            raise RuntimeError("일월로 정차 실험에는 순차적으로 전환되는 고정 신호 프로그램이 필요합니다.")
+        phases = logic.phases
+        deadline = traci.simulation.getTime() + max_wait_seconds
+        while traci.simulation.getTime() < deadline:
+            predicted_red = _seconds_to_green(phases) - env.step_length
+            desired_red = min_red_seconds <= predicted_red <= upper_red_seconds
+            if desired_red and _has_insertion_space(position, speed_mps, ego_length, min_gap, clear_ahead):
+                traci.vehicle.add(env.ego_id, ROUTE_ID, typeID="ego_type", departLane="2",
+                                  departPos=str(position), departSpeed=str(speed_mps))
+                traci.vehicle.setSpeedMode(env.ego_id, 0)
+                traci.vehicle.setLaneChangeMode(env.ego_id, 0)
+                traci.simulationStep()
+                if env.ego_id not in traci.vehicle.getIDList():
+                    traci.vehicle.remove(env.ego_id)
+                    continue
+                signal = env._tls_ahead()
+                speed = traci.vehicle.getSpeed(env.ego_id)
+                red_seconds = _seconds_to_green(phases)
+                leader = traci.vehicle.getLeader(env.ego_id, distance_m) if clear_ahead else None
+                obstruction = leader and leader[0] and leader[1] + min_gap < distance_m
+                if (signal and signal[:2] == (ILWOL_SIGNAL, ILWOL_LINK) and signal[3] in "rR"
+                    and traci.vehicle.getLaneID(env.ego_id) == ILWOL_LANE and not obstruction
+                    and min_red_seconds <= red_seconds <= upper_red_seconds
+                    and abs(signal[2] - distance_m) <= 0.2 and abs(speed - speed_mps) <= 0.2):
+                    _reset_tracking(env)
+                    return TrafficScene(env._get_obs(), env.seed_now, float(signal[2]), float(speed), red_seconds)
+                traci.vehicle.remove(env.ego_id)
+                continue
+            traci.simulationStep()
+    except BaseException:
+        env.close()
+        raise
+
+    env.close()
+    raise TrafficSceneUnavailable(f"시드 {seed}에서 {max_wait_seconds:g}초 안에 일월로 학습 장면을 만들지 못했습니다.")
+
+
+class TrafficStopScene(StopScene):
+    """Reuse a small fixed library of training cases and independent traffic seeds."""
+
+    def __init__(self, cfg, seed, cache_dir, *, stage=None, training_seeds=range(24),
+                 evaluation_seeds=range(1040, 1060), red_slack_seconds=18.0, max_wait_seconds=180.0):
+        super().__init__(cfg, seed)
+        self.cache_dir = Path(cache_dir)
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+        training_seeds = tuple(training_seeds)
+        self.traffic_evaluation_seeds = tuple(evaluation_seeds)
+        if not training_seeds or not self.traffic_evaluation_seeds:
+            raise ValueError("교통 커리큘럼 학습·평가 시드가 모두 필요합니다.")
+        if set(training_seeds) & set(self.traffic_evaluation_seeds):
+            raise ValueError("교통 커리큘럼 학습·평가 시드는 겹치면 안 됩니다.")
+        if not math.isfinite(red_slack_seconds) or red_slack_seconds < self.step_length:
+            raise ValueError("신호 시간 허용 오차는 한 스텝 이상이어야 합니다.")
+        if not math.isfinite(max_wait_seconds) or max_wait_seconds <= 0:
+            raise ValueError("투입 가능 상황을 기다리는 시간은 양수이어야 합니다.")
+        files = {*TRAFFIC_FILES, "skku.add.xml", "vtypes.add.xml", "bus.stops.xml", *cfg["scenario"].get("extra_routes", ())}
+        files.update(file for setting in self.mix for file in setting.get("extra_routes", ()))
+        signatures = [(name, (Path(MAP) / name).stat().st_mtime_ns) for name in sorted(files)]
+        settings = (cfg["scenario"], cfg["simulation"]["step_length"], signatures, red_slack_seconds)
+        if max_wait_seconds != 180.0:
+            settings += (max_wait_seconds,)
+        self.cache_key = json.dumps(settings, sort_keys=True)
+        self.red_slack_seconds = float(red_slack_seconds)
+        self.max_wait_seconds = float(max_wait_seconds)
+        stage = STAGES["far"] if stage is None else stage
+        library_rng = random.Random(seed)
+        self.traffic_training_cases = [(traffic_seed, sample_case(stage, library_rng)) for traffic_seed in training_seeds]
+        self.unavailable_cases = set()
+        self._unavailable_snapshots = {}
+        self._snapshot_file = None
+        self._run_evaluation_seeds = iter(())
+
+    def _state_file(self, seed):
+        return super()._state_file(seed) if self._snapshot_file is None else str(self._snapshot_file)
+
+    def _snapshot_paths(self, traffic_seed, case):
+        definition = (self.cache_key, traffic_seed, case.distance, case.speed, case.red_seconds)
+        identifier = hashlib.sha256(json.dumps(definition).encode("utf-8")).hexdigest()[:20]
+        return (self.cache_dir / f"stop-{identifier}.xml.gz", self.cache_dir / f"stop-{identifier}.json")
+
+    def _prepare_snapshot(self, traffic_seed, case, path, metadata_path):
+        scene = reset_traffic_scene(
+            self, distance_m=case.distance, speed_mps=case.speed, seed=traffic_seed,
+            min_red_seconds=case.red_seconds, max_red_seconds=case.red_seconds + self.red_slack_seconds,
+            max_wait_seconds=self.max_wait_seconds,
+        )
+        metadata = dict(time_s=traci.simulation.getTime(), seed=scene.seed, distance_m=scene.distance_m,
+                        speed_mps=scene.speed_mps, red_seconds=scene.red_seconds)
+        temp = path.with_name(f"{path.stem}-{os.getpid()}.xml.gz")
+        traci.simulation.saveState(str(temp))
+        temp.replace(path)
+        temp_metadata = metadata_path.with_suffix(f".{os.getpid()}.tmp")
+        temp_metadata.write_text(json.dumps(metadata), encoding="utf-8")
+        temp_metadata.replace(metadata_path)
+        return metadata
+
+    def _load_snapshot(self, traffic_seed, case):
+        path, metadata_path = self._snapshot_paths(traffic_seed, case)
+        if path.is_file() and metadata_path.is_file():
+            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
+        else:
+            if path in self._unavailable_snapshots:
+                raise TrafficSceneUnavailable(self._unavailable_snapshots[path])
+            try:
+                metadata = self._prepare_snapshot(traffic_seed, case, path, metadata_path)
+            except TrafficSceneUnavailable as error:
+                self._unavailable_snapshots[path] = str(error)
+                raise
+
+        self.close()
+        warmup = self.warmup_seconds
+        self.warmup_seconds = float(metadata["time_s"])
+        self._snapshot_file = path
+        try:
+            _start_seed(self, traffic_seed)
+        finally:
+            self.warmup_seconds = warmup
+            self._snapshot_file = None
+
+        try:
+            self.edges = self.approach_edges
+            signal = self._tls_ahead()
+            if (self.seed_now != metadata["seed"] or not signal or signal[:2] != (ILWOL_SIGNAL, ILWOL_LINK)
+                or signal[3] not in "rR" or abs(signal[2] - metadata["distance_m"]) > 0.2
+                or abs(traci.vehicle.getSpeed(self.ego_id) - metadata["speed_mps"]) > 0.2
+                or traci.vehicle.getLaneID(self.ego_id) != ILWOL_LANE):
+                raise RuntimeError(f"일월로 저장 장면의 초기 위치 또는 신호가 달라졌습니다: {path}")
+            traci.vehicle.setSpeedMode(self.ego_id, 0)
+            traci.vehicle.setLaneChangeMode(self.ego_id, 0)
+            _reset_tracking(self)
+            self.held_steps = 0
+            self.distance = signal[2]
+            return self._get_obs(), {"initial_distance": signal[2], "traffic_seed": traffic_seed,
+                                    "initial_speed": metadata["speed_mps"], "red_seconds": metadata["red_seconds"]}
+        except BaseException:
+            self.close()
+            raise
+
+    def reset(self, seed=None, options=None):
+        gym.Env.reset(self, seed=seed)
+        if self.evaluating:
+            return self._load_snapshot(next(self._run_evaluation_seeds), next(self.evaluation_cases))
+
+        available = [scene for scene in self.traffic_training_cases if scene[0] not in self.unavailable_cases]
+        self.rng.shuffle(available)
+        for traffic_seed, case in available:
+            try:
+                return self._load_snapshot(traffic_seed, case)
+            except TrafficSceneUnavailable:
+                self.unavailable_cases.add(traffic_seed)
+        raise TrafficSceneUnavailable("일월로 교통 커리큘럼 학습 시드에서 사용할 수 있는 장면이 없습니다.")
+
+
+def evaluate_traffic(env, agent, stage, seed, count=20):
+    """Test the same sampled cases on the same held-out traffic seeds at each gate."""
+    if count > len(env.traffic_evaluation_seeds):
+        raise ValueError("요청한 교통 평가 횟수보다 평가 시드가 적습니다.")
+    env.evaluating = True
+    rows = []
+    try:
+        for traffic_seed in env.traffic_evaluation_seeds[:count]:
+            # Pick cases by whether the scene can be formed, before the policy takes any action.
+            rng = random.Random(f"ilwol-eval:{seed}:{traffic_seed}")
+            reasons = []
+            for attempt in range(1, 5):
+                case = sample_case(stage, rng)
+                env.evaluation_cases = iter((case,))
+                env._run_evaluation_seeds = iter((traffic_seed,))
+                try:
+                    observation, initial = env.reset()
+                except TrafficSceneUnavailable as error:
+                    reasons.append(str(error))
+                else:
+                    break
+            else:
+                rows.append(dict(traffic_seed=traffic_seed, attempts=4, stopped=False, red=False, collision=False,
+                                 unavailable=reasons))
+                continue
+            while True:
+                observation, _, done, truncated, info = env.step(agent.predict(observation, deterministic=True))
+                if done or truncated:
+                    break
+            rows.append(dict(**initial, case=asdict(case), attempts=attempt, steps=env.step_count, stopped=bool(info["stop_success"]),
+                             red=bool(info["red_light"]), collision=bool(info["collided"]),
+                             release_distance=info.get("release_distance"), speed_at_release=info["speed"],
+                             held_steps=env.held_steps))
+    finally:
+        env.evaluating = False
+    return dict(successes=sum(row["stopped"] for row in rows), red_entries=sum(row["red"] for row in rows),
+                collisions=sum(row["collision"] for row in rows), unavailable=sum("unavailable" in row for row in rows),
+                episodes=rows)
