@@ -0,0 +1,322 @@
+"""PPO curriculum for the Ilwol-ro stop line using SUMO training scenes."""
+
+import argparse
+import json
+import math
+import random
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+import course
+import config
+import gymnasium as gym
+import torch
+from sumolib import checkBinary
+
+from ppo_fix import PPOFixed
+from skku_env import MAP, ROUTE_ID, SkkuEnv, traci
+from utils.buffer import RolloutBuffer
+from utils.logger import RunLogger
+
+
+EDGE = "5612296410"
+LANE = f"{EDGE}_2"
+SIGNAL = "520991292"
+LINK = 10
+TARGET = 3.5
+
+
+@dataclass(frozen=True)
+class Stage:
+    distance: tuple[float, float]
+    speed: tuple[float, float]
+    red_seconds: tuple[float, float]
+
+
+STAGES = {
+    "near": Stage((10, 20), (0, 3), (10, 17)),
+    "middle": Stage((25, 60), (2, 7), (15, 24)),
+    "far": Stage((75, 100), (4, 11), (21, 30)),
+}
+TRAINING_NEAR = Stage((8, 20), (0, 5.0), (10, 17))
+TRAINING_HOLD = Stage((4.5, 8), (0, 2.5), (8, 14))
+
+
+@dataclass(frozen=True)
+class Case:
+    distance: float
+    speed: float
+    red_seconds: float
+
+
+def sample_case(stage, rng):
+    return Case(rng.uniform(*stage.distance), rng.uniform(*stage.speed), rng.uniform(*stage.red_seconds))
+
+
+def stop_shaping(previous_distance, distance, speed):
+    error = abs(distance - TARGET)
+    progress = abs(previous_distance - TARGET) - error
+    desired_speed = min(6.0, math.sqrt(2 * max(distance - TARGET, 0)))
+    reward = 0.15 * progress - 0.10 * min(abs(speed - desired_speed) / 6.0, 1.0)
+    reward -= 0.05 * min(error / 12.0, 1.0)
+    if 2 <= distance <= 5:
+        reward += 0.15 * max(1.0 - speed / 0.45, 0.0)
+    return reward
+
+
+def load_checkpoint(agent, path):
+    state = torch.load(path, map_location=agent.device, weights_only=True)
+    first = "trunk.0.weight"
+    difference = agent.policy.state_dict()[first].shape[1] - state[first].shape[1]
+    if difference == 3:
+        state[first] = torch.nn.functional.pad(state[first], (0, 3))
+    agent.policy.load_state_dict(state)
+
+
+def preserve_reference(agent, bank_path, reference, folder, cfg, coefficient, seed):
+    anchors = torch.load(bank_path, map_location="cpu", weights_only=True)
+    if cfg["scenario"].get("obs_stop_line") and anchors.shape[1] + 3 == agent.policy.trunk[0].in_features:
+        speed = anchors[:, 0] * cfg["scenario"]["speed_limit"]
+        remaining = 100 * anchors[:, 31] - TARGET
+        red = anchors[:, 32:33]
+        features = torch.stack((remaining / 25, (remaining - speed ** 2 / 4) / 25, speed / 6), dim=1)
+        anchors = torch.cat((anchors, features.clamp(-1, 1) * red), dim=1)
+        state = torch.load(reference, map_location="cpu", weights_only=True)
+        state["trunk.0.weight"] = torch.nn.functional.pad(state["trunk.0.weight"], (0, 3))
+        reference = str(folder / "expanded_reference.pt")
+        torch.save(state, reference)
+    agent.set_anchor_bank(anchors, reference, coefficient=coefficient, seed=seed)
+
+
+class StopScene(SkkuEnv):
+    """Use the same observations and model actions, with short, repeatable red approaches."""
+
+    def __init__(self, cfg, seed):
+        super().__init__(cfg["scenario"], cfg["simulation"], cfg["observation"], cfg["action"], cfg["reward"], gui=False)
+        self.approach_edges = self._full_edges[self._full_edges.index(EDGE):]
+        self.rng = random.Random(seed)
+        self.training_stages = [STAGES["near"]]
+        self.evaluation_cases = iter(())
+        self.evaluating = False
+        self.scene_number = 0
+        self.held_steps = 0
+        self.distance = 0.0
+        self.single_lane_training = False
+
+    def _open_empty_network(self):
+        network = str(Path(MAP) / "skku.net.xml")
+        traci.start([checkBinary("sumo"), "-n", network, "--step-length", str(self.step_length),
+                     "--end", "10000000", "--no-warnings", "true", "--no-step-log", "true",
+                     "--collision.action", "remove", "--collision.check-junctions", "true"])
+        self._started = True
+        self.edges = self.approach_edges
+        traci.route.add(ROUTE_ID, self.edges)
+        traci.vehicletype.copy("DEFAULT_VEHTYPE", "ego_type")
+
+    def reset(self, seed=None, options=None):
+        gym.Env.reset(self, seed=seed)
+        if self.evaluating:
+            case = next(self.evaluation_cases)
+        else:
+            weights = [1] * (len(self.training_stages) - 1) + [4]
+            case = sample_case(self.rng.choices(self.training_stages, weights=weights)[0], self.rng)
+        if not self._started:
+            self._open_empty_network()
+        elif self.ego_id in traci.vehicle.getIDList():
+            traci.vehicle.remove(self.ego_id)
+
+        # The original phases are red at index 0, followed by a three-second transition
+        # and then green for the left-turn connection. Only shorten the initial red phase.
+        traci.trafficlight.setPhase(SIGNAL, 0)
+        traci.trafficlight.setPhaseDuration(SIGNAL, case.red_seconds)
+        self.scene_number += 1
+        self.ego_id = f"stop_ego_{self.scene_number}"
+        position = traci.lane.getLength(LANE) - case.distance
+        traci.vehicle.add(self.ego_id, ROUTE_ID, typeID="ego_type", depart="now", departLane="2",
+                          departPos=str(position), departSpeed=str(case.speed))
+        traci.vehicle.setSpeedMode(self.ego_id, 0)
+        traci.vehicle.setLaneChangeMode(self.ego_id, 0)
+        traci.simulationStep()
+        signal = self._tls_ahead()
+        assert signal and signal[:2] == (SIGNAL, LINK) and signal[3] in ("r", "R"), (case, signal)
+        self.step_count = self.held_steps = 0
+        self._prev_accel = None
+        self.distance = signal[2]
+        return self._get_obs(), {"case": asdict(case), "initial_distance": self.distance}
+
+    def _apply_lane_change(self, direction):
+        if self.single_lane_training and not self.evaluating:
+            direction = 0
+        return super()._apply_lane_change(direction)
+
+    def step(self, action):
+        obs, _, terminated, truncated, info = super().step(action)
+        info["stop_success"] = False
+        signal = self._tls_ahead() if info["speed"] is not None else None
+        if info.get("collided") or info.get("red_light"):
+            return obs, -12.0, True, False, info
+        if terminated or truncated or signal is None or signal[:2] != (SIGNAL, LINK):
+            return obs, -8.0, True, False, info
+
+        speed, distance, state = info["speed"], signal[2], signal[3]
+        error = abs(distance - TARGET)
+        if state in ("G", "g"):
+            info["stop_success"] = self.held_steps >= 4 and 2 <= distance <= 5
+            info["release_distance"] = distance
+            return obs, 5.0 if info["stop_success"] else -1.0 - min(error / 12.0, 3.0), True, False, info
+
+        reward = stop_shaping(self.distance, distance, speed)
+        self.distance = distance
+        within_window = 2 <= distance <= 5
+        self.held_steps = self.held_steps + 1 if within_window and speed < 0.1 else 0
+        return obs, reward, False, False, info
+
+
+def evaluate_scene(env, agent, stage, seed, count=20):
+    rng = random.Random(seed)
+    cases = [sample_case(stage, rng) for _ in range(count)]
+    env.evaluation_cases = iter(cases)
+    env.evaluating = True
+    rows = []
+    try:
+        for case in cases:
+            obs, reset = env.reset()
+            while True:
+                obs, _, done, truncated, info = env.step(agent.predict(obs, deterministic=True))
+                if done or truncated:
+                    break
+            rows.append(dict(case=asdict(case), initial_distance=reset["initial_distance"], steps=env.step_count,
+                             stopped=bool(info["stop_success"]), red=bool(info["red_light"]),
+                             collision=bool(info["collided"]), release_distance=info.get("release_distance"),
+                             speed_at_release=info["speed"], held_steps=env.held_steps))
+    finally:
+        env.evaluating = False
+    return dict(successes=sum(row["stopped"] for row in rows), red_entries=sum(row["red"] for row in rows),
+                collisions=sum(row["collision"] for row in rows), episodes=rows)
+
+
+def train_stages(env, agent, folder, stage_names, block_steps, budget, logger, evaluator=evaluate_scene):
+    passed = []
+    for stage_name in stage_names:
+        stage_index = list(STAGES).index(stage_name)
+        env.training_stages = [TRAINING_HOLD, TRAINING_NEAR, *(STAGES[name] for name in list(STAGES)[1:stage_index + 1])]
+        stage = STAGES[stage_name]
+        stage_start = agent.num_timesteps
+        while True:
+            steps = agent.num_timesteps
+            metric = evaluator(env, agent, stage, seed=200000 + stage_index)
+            print(f"GATE {stage_name} {steps} success={metric['successes']}/20 red={metric['red_entries']}"
+                  f" collisions={metric['collisions']}", flush=True)
+            (folder / f"{stage_name}_{steps}_gate.json").write_text(json.dumps(metric, indent=2) + "\n", encoding="utf-8")
+            agent.save(str(folder / f"{stage_name}_{steps}.pt"))
+            if metric["successes"] >= 18 and metric["red_entries"] == metric["collisions"] == 0:
+                audit = evaluator(env, agent, stage, seed=300000 + stage_index)
+                (folder / f"{stage_name}_{steps}_audit.json").write_text(json.dumps(audit, indent=2) + "\n", encoding="utf-8")
+                print(f"AUDIT {stage_name} {steps} success={audit['successes']}/20 red={audit['red_entries']}"
+                      f" collisions={audit['collisions']}", flush=True)
+                if audit["successes"] >= 18 and audit["red_entries"] == audit["collisions"] == 0:
+                    agent.save(str(folder / f"{stage_name}_passed.pt"))
+                    passed.append(stage_name)
+                    break
+            if steps - stage_start >= budget:
+                print(f"STAGE_BUDGET {stage_name} {steps}", flush=True)
+                return passed
+            agent.learn(env, total_timesteps=steps + block_steps, logger=logger, log_interval=4)
+    return passed
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--init", required=True)
+    ap.add_argument("--output", required=True, type=Path)
+    ap.add_argument("--stages", default="near,middle,far")
+    ap.add_argument("--block", default=4096, type=int)
+    ap.add_argument("--budget", default=32768, type=int)
+    ap.add_argument("--lr", default=0.00025, type=float)
+    ap.add_argument("--seed", default=21, type=int)
+    ap.add_argument("--freeze-trunk", action="store_true")
+    ap.add_argument("--accel-bias", default=0.0, type=float)
+    ap.add_argument("--exploration", default=0.30, type=float)
+    ap.add_argument("--single-lane-training", action="store_true")
+    ap.add_argument("--stop-line-observation", action="store_true")
+    ap.add_argument("--value-coef", default=0.5, type=float)
+    ap.add_argument("--stop-inputs-only", action="store_true")
+    ap.add_argument("--distance-initialization", default=0.0, type=float)
+    ap.add_argument("--traffic", action="store_true")
+    ap.add_argument("--traffic-cache", type=Path)
+    ap.add_argument("--traffic-max-wait", default=500, type=float)
+    ap.add_argument("--anchors", type=Path)
+    ap.add_argument("--anchor-coef", default=0.2, type=float)
+    ap.add_argument("--probe", action="store_true")
+    args = ap.parse_args()
+    if args.stop_inputs_only and not args.stop_line_observation:
+        ap.error("--stop-inputs-only requires --stop-line-observation")
+    args.output.mkdir(parents=True, exist_ok=True)
+    cfg = config.load("r_s3y")
+    if args.stop_line_observation:
+        cfg["scenario"] = dict(cfg["scenario"], obs_stop_line=True)
+    evaluator = evaluate_scene
+    if args.traffic:
+        from stop_curriculum_traffic import TrafficStopScene, evaluate_traffic
+
+        env = TrafficStopScene(cfg, args.seed, args.traffic_cache or args.output / "traffic_cache",
+                               max_wait_seconds=args.traffic_max_wait)
+
+        def evaluator(scene, policy, stage, seed, count=20):
+            scene.traffic_evaluation_seeds = tuple(range(1020, 1040) if seed >= 300000 else range(1040, 1060))
+            return evaluate_traffic(scene, policy, stage, seed, count)
+    else:
+        env = StopScene(cfg, args.seed)
+    env.single_lane_training = args.single_lane_training
+    hparams = dict(cfg["hparams"], seed=args.seed, lr=args.lr, n_steps=512, minibatch_size=64,
+                   lane_entropy_coef=0.0, clip_eps=0.16, value_coef=args.value_coef)
+    algorithm = PPOFixed
+    if args.anchors:
+        from stop_curriculum_ppo import PPOAnchored
+
+        algorithm = PPOAnchored
+    agent = algorithm(obs_dim=env.observation_space.shape[0], act_dim=env.action_space.shape[0],
+                      buffer=RolloutBuffer(), **hparams)
+    load_checkpoint(agent, args.init)
+    if args.anchors:
+        preserve_reference(agent, args.anchors, "models/best_1119_soupA.pt", args.output, cfg,
+                           args.anchor_coef, args.seed)
+    agent.policy.lane_head.requires_grad_(False)
+    if args.freeze_trunk:
+        agent.policy.trunk.requires_grad_(False)
+    if args.stop_inputs_only:
+        agent.policy.requires_grad_(False)
+        first = agent.policy.trunk[0].weight
+        first.requires_grad_(True)
+        agent.policy.v_head.requires_grad_(True)
+        agent.policy.log_std.requires_grad_(True)
+        mask = torch.zeros_like(first)
+        mask[:, -3:] = 1
+        first.register_hook(lambda gradient: gradient * mask)
+        if args.distance_initialization:
+            with torch.no_grad():
+                first[:, -3].copy_(first[:, 31] * args.distance_initialization)
+    with torch.no_grad():
+        agent.policy.log_std.clamp_(max=math.log(args.exploration))
+        agent.policy.mu_head.bias.add_(args.accel_bias)
+    cfg.update(init=str(Path(args.init).resolve()), hparams=hparams)
+    (args.output / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
+    if args.probe:
+        try:
+            for name in args.stages.split(","):
+                result = evaluator(env, agent, STAGES[name], seed=19000, count=4)
+                print(name, json.dumps(result), flush=True)
+        finally:
+            env.close()
+        return
+    logger = RunLogger(str(args.output))
+    try:
+        passed = train_stages(env, agent, args.output, args.stages.split(","), args.block, args.budget, logger, evaluator)
+        (args.output / "stages.json").write_text(json.dumps(passed) + "\n", encoding="utf-8")
+    finally:
+        env.close()
+        logger.close()
+
+
+if __name__ == "__main__":
+    main()
