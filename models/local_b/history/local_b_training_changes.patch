+"""Continue PPO on the full SUMO route, keeping the staged stop objective during training."""
+
+import argparse
+import json
+from pathlib import Path
+
+from stop_curriculum import EDGE, LINK, SIGNAL, preserve_reference, stop_shaping
+from stop_curriculum_ppo import PPOAnchored
+from skku_env import SkkuEnv, traci
+import config
+from utils.buffer import RolloutBuffer
+from utils.logger import RunLogger
+
+
+class RouteStopTraining(SkkuEnv):
+    """Score the learned stop under moving traffic without replacing policy actions."""
+
+    def reset(self, seed=None, options=None):
+        self.stop_distance = None
+        self.held_steps = 0
+        return super().reset(seed=seed, options=options)
+
+    def step(self, action):
+        obs, reward, terminated, truncated, info = super().step(action)
+        speed = info["speed"]
+        state = info.get("tls_state")
+        distance = info.get("tls_distance_m", -1)
+        ego = self.ego_id
+        if speed is not None and 0 <= distance <= 100 and traci.vehicle.getRoadID(ego) == EDGE:
+            signal = self._tls_ahead()
+            if signal is not None and signal[:2] == (SIGNAL, LINK):
+                if state in ("g", "G") and self.stop_distance is not None:
+                    if self.held_steps * self.step_length >= 2.0 and 2 <= distance <= 5:
+                        reward += 5.0
+                elif state in ("r", "R", "u"):
+                    leader = traci.vehicle.getLeader(ego, 100)
+                    clear = not (leader and leader[0] and leader[1] + traci.vehicle.getMinGap(ego) < distance)
+                    if clear:
+                        previous = distance if self.stop_distance is None else self.stop_distance
+                        reward += 0.6 * stop_shaping(previous, distance, speed)
+                        self.stop_distance = distance
+                        self.held_steps = self.held_steps + 1 if 2 <= distance <= 5 and speed < 0.1 else 0
+                        return obs, reward, terminated, truncated, info
+        if self.stop_distance is not None and info.get("red_light"):
+            reward -= 6.0
+        self.stop_distance = None
+        self.held_steps = 0
+        return obs, reward, terminated, truncated, info
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--init", required=True)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--steps", type=int, default=51200)
+    parser.add_argument("--reference", default="models/best_1119_soupA.pt")
+    parser.add_argument("--config", type=Path)
+    parser.add_argument("--anchors", type=Path)
+    parser.add_argument("--anchor-coef", type=float, default=0.35)
+    parser.add_argument("--lr", type=float, default=0.00005)
+    parser.add_argument("--checkpoint-every", type=int, default=8192)
+    parser.add_argument("--seed", type=int, default=23)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    cfg = json.loads(args.config.read_text(encoding="utf-8")) if args.config else config.load("r_s3y")
+    cfg["scenario"] = dict(cfg["scenario"], start_mix=[cfg["scenario"]["start_edge"]] * 3 + [EDGE])
+    cfg["reward"] = dict(cfg["reward"], red_light_penalty=6.0)
+    cfg["hparams"] = dict(cfg["hparams"], lr=args.lr, seed=args.seed)
+    env = RouteStopTraining(cfg["scenario"], cfg["simulation"], cfg["observation"], cfg["action"], cfg["reward"])
+    agent = PPOAnchored(obs_dim=env.observation_space.shape[0], act_dim=env.action_space.shape[0],
+                        buffer=RolloutBuffer(), **cfg["hparams"])
+    agent.load(args.init)
+    if args.anchors is not None:
+        preserve_reference(agent, args.anchors, args.reference, args.output, cfg, args.anchor_coef, args.seed)
+    cfg.update(init=str(Path(args.init).resolve()), transfer_steps=args.steps, anchor_coefficient=agent.anchor_kl_coef)
+    (args.output / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
+    logger = RunLogger(str(args.output))
+    log_train = logger.log_train
+
+    def save_log(step, metrics, verbose=True):
+        log_train(step, metrics, verbose=verbose)
+        if step % args.checkpoint_every == 0:
+            agent.save(str(args.output / f"model_{step}.pt"))
+
+    logger.log_train = save_log
+    try:
+        agent.learn(env, total_timesteps=args.steps, logger=logger)
+        agent.save(str(args.output / "model.pt"))
+    finally:
+        env.close()
+        logger.close()
+
+
+if __name__ == "__main__":
+    main()
